rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(data) {
      return request.auth != null && data.ownerUid == request.auth.uid;
    }

    function hasValidOptionalFields(data) {
      return (!data.keys().hasAny(['ownerPhotoURL']) ||
          (data.get('ownerPhotoURL', '') is string &&
           data.get('ownerPhotoURL', '').size() > 0 &&
           data.get('ownerPhotoURL', '').size() <= 2048)) &&
        (!data.keys().hasAny(['imageURL']) ||
          (data.get('imageURL', '') is string &&
           data.get('imageURL', '').size() > 0 &&
           data.get('imageURL', '').size() <= 2048));
    }

    function hasValidListingShape(data) {
      return data.keys().hasAll([
          'title', 'category', 'condition', 'description', 'transactionType',
          'ownerUid', 'ownerName', 'ownerEmail', 'createdAt', 'status'
        ]) &&
        data.keys().hasOnly([
          'title', 'category', 'condition', 'description', 'transactionType',
          'ownerUid', 'ownerName', 'ownerEmail', 'ownerPhotoURL', 'createdAt',
          'status', 'imageURL'
        ]) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.category is string && data.category in [
          'Textbooks / Workbooks', 'Stationery', 'Uniforms / PE Kits',
          'Art & Craft Supplies', 'Sports Equipment', 'Electronics',
          'School Bags / Lunchboxes', 'Other'
        ] &&
        data.condition is string && data.condition in ['Good', 'Medium', 'Poor'] &&
        data.description is string && data.description.size() > 0 && data.description.size() <= 2000 &&
        data.transactionType is string && data.transactionType in ['free', 'exchange'] &&
        data.ownerUid is string && data.ownerUid.size() > 0 &&
        data.ownerName is string && data.ownerName.size() > 0 && data.ownerName.size() <= 100 &&
        data.ownerEmail is string && data.ownerEmail.size() > 0 && data.ownerEmail.size() <= 254 &&
        data.createdAt is timestamp &&
        data.status is string && data.status in ['active', 'removed'] &&
        hasValidOptionalFields(data);
    }

    function isValidCreate(data) {
      return request.auth != null &&
        hasValidListingShape(data) &&
        data.ownerUid == request.auth.uid &&
        data.ownerName == request.auth.token.get('name', '') &&
        data.ownerEmail == request.auth.token.get('email', '') &&
        (!data.keys().hasAny(['ownerPhotoURL']) ||
          data.get('ownerPhotoURL', '') == request.auth.token.get('picture', '')) &&
        data.createdAt == request.time &&
        data.status == 'active';
    }

    function isValidUpdate() {
      let changedFields = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(resource.data) &&
        hasValidListingShape(request.resource.data) &&
        changedFields.hasOnly([
          'title', 'category', 'condition', 'description', 'transactionType',
          'status', 'imageURL'
        ]) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.ownerName == resource.data.ownerName &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.get('ownerPhotoURL', '') == resource.data.get('ownerPhotoURL', '') &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /listings/{listingId} {
      // Public visitors may read active listings; owners can also read their removed listings.
      allow get, list: if resource.data.status == 'active' || isOwner(resource.data);
      allow create: if isValidCreate(request.resource.data);
      allow update: if isValidUpdate();
      allow delete: if isOwner(resource.data);
    }
  }
}
